generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  status          TenantStatus @default(ACTIVE)
  
  // White-label branding
  logoUrl         String?  @map("logo_url")
  primaryColor    String?  @map("primary_color")
  secondaryColor  String?  @map("secondary_color")
  customDomain    String?  @unique @map("custom_domain")
  
  // Feature flags
  features        Json     @default("{}")
  
  // Configuration
  feeBps          Int      @default(250) @map("fee_bps")
  maxCreators     Int      @default(1000) @map("max_creators")
  maxPassesPerCreator Int  @default(100) @map("max_passes_per_creator")
  
  // Contact info
  adminEmail      String?  @map("admin_email")
  supportEmail    String?  @map("support_email")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  users           User[]
  creators        Creator[]
  categories      Category[]
  
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  TRIAL
}

model User {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  stellarAddress String    @map("stellar_address")
  role           UserRole  @default(FAN)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  creator        Creator?
  fan            Fan?
  sessions       Session[]
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("users")
  @@index([tenantId])
  @@unique([tenantId, stellarAddress])
}

enum UserRole {
  CREATOR
  FAN
  ADMIN
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model Creator {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  stellarAddress String    @map("stellar_address")
  email          String?   @map("email")
  displayName    String    @map("display_name")
  bio            String?
  avatarUrl      String?   @map("avatar_url")
  totalEarned    Decimal   @default(0) @map("total_earned")
  registeredAt   DateTime  @map("registered_at")
  featured       Boolean   @default(false)
  featuredOrder  Int       @default(0) @map("featured_order")
  verified       Boolean   @default(false)
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tiers          Tier[]
  passes         Pass[]
  blocks         Block[]
  categories     Category[]
  contentSchedules ContentSchedule[]
  webhooks       WebhookConfig[]
  payouts        Payout[]
  earningsRecords EarningsRecord[]
  creatorMembers  CreatorMember[]
  @@map("creators")
  @@index([tenantId])
  @@unique([tenantId, userId])
  @@unique([tenantId, stellarAddress])
  @@index([tenantId, email], where: { email: { not: null } })
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  slug      String
  creators  Creator[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
  @@index([tenantId])
  @@unique([tenantId, slug])
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payout {
  id        String       @id @default(uuid())
  creatorId String       @map("creator_id")
  amount    Decimal
  txHash    String?      @map("tx_hash")
  status    PayoutStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  creator   Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@map("payouts")
}

model WebhookConfig {
  id        String   @id @default(uuid())
  creatorId String   @map("creator_id")
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@map("webhook_configs")
}

model Fan {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  userId              String    @map("user_id")
  stellarAddress      String    @map("stellar_address")
  email               String?   @map("email")
  displayName         String?   @map("display_name")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  anonymized          Boolean   @default(false)
  permanentlyDeletedAt DateTime? @map("permanently_deleted_at")
  lastExportRequestedAt DateTime? @map("last_export_requested_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passes              Pass[]
  notifications       Notification[]
  earningsRecords     EarningsRecord[]
  @@map("fans")
  @@index([tenantId])
  @@unique([tenantId, userId])
  @@unique([tenantId, stellarAddress])
  @@index([tenantId, email], where: { email: { not: null } })
}

model Tier {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  onChainId    Int           @map("on_chain_id")
  creatorId    String        @map("creator_id")
  name         String
  description  String?
  priceUsdc    Decimal       @map("price_usdc")
  durationDays Int           @map("duration_days")
  trialDays    Int           @default(0) @map("trial_days")
  maxSupply    Int           @default(0) @map("max_supply")
  minted       Int           @default(0)
  active       Boolean       @default(true)
  syncedAt     DateTime      @map("synced_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passes       Pass[]
  waitlist     WaitlistEntry[]
  earningsRecords EarningsRecord[]
  prices       TierPrice[]
  contentSchedules ContentSchedule[]
  @@unique([creatorId, onChainId])
  @@map("tiers")
  @@index([tenantId])
}

model TierPrice {
  id        String   @id @default(uuid())
  tierId    String   @map("tier_id")
  token     String
  amount    Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  @@unique([tierId, token])
  @@map("tier_prices")
}

model WaitlistEntry {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tierId       String   @map("tier_id")
  fanAddress   String   @map("fan_address")
  joinedAt      DateTime @default(now()) @map("joined_at")
  notified     Boolean  @default(false)
  tier          Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@unique([tierId, fanAddress])
  @@map("waitlist_entries")
  @@index([tenantId])
}

model Pass {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  onChainId   BigInt   @unique @map("on_chain_id")
  tierId      String   @map("tier_id")
  creatorId   String   @map("creator_id")
  fanId       String   @map("fan_id")
  purchasedAt DateTime @map("purchased_at")
  expiresAt   DateTime @map("expires_at")
  txHash      String?  @map("tx_hash")
  metadata    Json?
  active      Boolean  @default(true)
  trialUsed   Boolean  @default(false) @map("trial_used")
  autoRenew   Boolean  @default(false) @map("auto_renew")
  supersededBy String?   @map("superseded_by")
  syncedAt    DateTime @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  tier        Tier     @relation(fields: [tierId], references: [id])
  creator     Creator  @relation(fields: [creatorId], references: [id])
  fan         Fan      @relation(fields: [fanId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  renewalAttempts RenewalAttempt[]
  @@map("passes")
  @@index([tenantId])
}

enum RenewalAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

model RenewalAttempt {
  id          String               @id @default(uuid())
  passId      String               @map("pass_id")
  status      RenewalAttemptStatus @default(PENDING)
  txHash      String?              @map("tx_hash")
  error       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  pass        Pass                 @relation(fields: [passId], references: [id], onDelete: Cascade)
  @@map("renewal_attempts")
}

model EarningsRecord {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  creatorId String   @map("creator_id")
  fanId     String   @map("fan_id")
  tierId    String   @map("tier_id")
  amount    Decimal  @map("amount")
  fee       Decimal  @default(0) @map("fee")
  netAmount Decimal  @map("net_amount")
  createdAt DateTime @default(now()) @map("created_at")
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  tier      Tier     @relation(fields: [tierId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("earnings_records")
  @@index([tenantId])
}

model IndexerCheckpoint {
  id         String   @id @default("singleton")
  lastLedger Int      @default(0) @map("last_ledger")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("indexer_checkpoints")
}

model PlatformConfig {
  id          String   @id @default("singleton")
  feeBps      Int      @default(250) @map("fee_bps")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  @@map("platform_configs")
}

model Block {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  creatorId String   @map("creator_id")
  blockedAddress String @map("blocked_address")
  createdAt DateTime @default(now()) @map("created_at")
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([creatorId, blockedAddress])
  @@map("blocks")
  @@index([tenantId])
}

model CreatorMember {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  creatorId String   @map("creator_id")
  address   String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([creatorId, address])
  @@map("creator_members")
  @@index([tenantId])
}

model ContentSchedule {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  creatorId  String   @map("creator_id")
  tierId     String   @map("tier_id")
  contentUrl String   @map("content_url")
  availableAt DateTime @map("available_at")
  active     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tier       Tier     @relation(fields: [tierId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("content_schedules")
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  fanId     String   @map("fan_id")
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([tenantId])
}
